{
  "name": "loja",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/entry.js",
    "server": "node --env-file=server/.env server/index.js",
    "dev:server": "nodemon --env-file=server/.env server/index.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "dev:full:nodev": "concurrently \"npm run dev:server\"",
    "build:full": "npm run build && cp -r dist server/public",
    "prod": "NODE_ENV=production node --env-file=server/.env server/index.js",
    "start:prod": "NODE_ENV=production node server/entry.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "oxlint": "^1.71.0"
  }
}
